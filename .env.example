# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Lyzr Studio (deployed agents)
LYZR_API_KEY=
LYZR_USER_ID=
LYZR_BASE_URL=https://agent-prod.studio.lyzr.ai/v3
LYZR_RAG_BASE_URL=https://rag-prod.studio.lyzr.ai/v3

# Studio agent IDs (from each agent's listing)
LYZR_MANAGER_AGENT_ID=
LYZR_RESEARCH_AGENT_ID=
LYZR_OUTREACH_AGENT_ID=
LYZR_KB_ID=

# Direct tool keys (used only in LIVE runs; seed mode never touches Apollo)
TAVILY_API_KEY=
APOLLO_API_KEY=
STUDIO_APOLLO=

# Safety switch: Apollo / the Research agent are reachable only when =1. Default 0.
LYZR_LIVE=0

# Evidence cache (PRD §17.a). Leave blank to run without a cache.
# Local: run `supabase start` and paste its "API URL" + "anon key" here.
SUPABASE_URL=
SUPABASE_KEY=
CACHE_ENABLED=1
CACHE_TTL_DAYS=7
